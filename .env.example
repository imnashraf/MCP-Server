# Placeholders only. Copy to .env (git-ignored) and fill in. Never commit real values.
NODE_ENV=development
MCP_TRANSPORT=stdio            # stdio | http
LOG_LEVEL=info                 # debug | info | warn | error | silent (logs go to stderr)

# --- Google OAuth (Desktop or Web client from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Must be OUTSIDE the project directory. Default: ~/.config/universal-google-workspace-mcp/tokens.json
GOOGLE_TOKEN_STORE_PATH=
GOOGLE_API_TIMEOUT_MS=30000

# --- Capabilities ---
ENABLE_GMAIL_SEND=true
ENABLE_DOCS_APPEND=true

# --- Gmail policy (optional) ---
GMAIL_ALLOWED_RECIPIENTS=            # comma-separated exact addresses; empty = no restriction
GMAIL_ALLOWED_RECIPIENT_DOMAINS=     # comma-separated domains; empty = no restriction
GMAIL_ENABLE_HTML_BODY=false
GMAIL_REQUIRE_CONFIRM_SEND=false     # require confirm_send=true on every call
GMAIL_MAX_RECIPIENTS=100

# --- Idempotency (single-node file store; not valid for multi-instance deployments) ---
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_STORE_PATH=
IDEMPOTENCY_TTL_HOURS=168

# --- Remote (Streamable HTTP) profile ---
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Required for http. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_AUTH_MODE=            # leave unset: stdio -> none, http -> bearer (http refuses "none")
MCP_ACCESS_TOKEN=
MCP_HTTP_ALLOWED_HOSTS=              # e.g. mcp.example.com (required when exposing publicly)
MCP_HTTP_ALLOWED_ORIGINS=            # browser Origins allowed; empty = reject all browser origins
MCP_HTTP_MAX_BODY_BYTES=1048576
MCP_HTTP_RATE_LIMIT_PER_MINUTE=60
MCP_HTTP_TRUST_PROXY=false
MCP_HTTP_BEHIND_TLS_PROXY=false      # true when a reverse proxy terminates HTTPS
MCP_HTTP_TLS_CERT_PATH=
MCP_HTTP_TLS_KEY_PATH=
